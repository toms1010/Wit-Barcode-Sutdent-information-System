title: Live Barcode Scanning and Verification Pipeline
---
flowchart LR
    START(["Camera frame acquired<br/>or card image uploaded"]) --> PRE["Preprocess<br/>letterbox to 640 x 640, colour normalisation"]
    PRE --> DET["YOLOv8n detection<br/>confidence threshold 0.75, NMS IoU 0.45"]
    DET --> FOUND{"Any barcode box<br/>above threshold?"}

    FOUND -->|"No"| FALLBACK{"Whole-frame decode<br/>fallback due?"}
    FALLBACK -->|"Yes"| FRAME["Full-frame decode<br/>(4 attempts, rate limited)"]
    FRAME --> DECODED
    FALLBACK -->|"No"| SEARCHING(["State: SEARCHING"])

    FOUND -->|"Yes"| GATE{"Quality / edge gate<br/>box inside the decode region,<br/>crop >= 80 x 24 px"}
    GATE -->|"Rejected"| EDGE(["State: BARCODE_DETECTED<br/>'move the card further into frame'"])
    GATE -->|"Accepted"| CROP["Crop with 30% margin,<br/>suppress overlapping boxes"]
    CROP --> DECODE["Multi-strategy decode<br/>original, gray, upscale 2x/3x/4x, unsharp,<br/>otsu, clahe, adaptive, denoise, rotate"]
    DECODE --> DECODED{"Payload read?"}

    DECODED -->|"No"| REC["CODE39 reconstruction<br/>module-width voting from a binarised crop"]
    REC --> DECODED2{"Payload recovered?"}
    DECODED2 -->|"No"| UNDECODED(["State: ERROR /<br/>'unable to decode, adjust position or lighting'"])
    DECODED2 -->|"Yes"| LOOKUP

    DECODED -->|"Yes"| LOOKUP["Exact SQL lookup<br/>barcode_scans / students by barcode_payload"]
    LOOKUP --> MATCH{"Student row<br/>confirmed?"}

    MATCH -->|"No row"| UNKNOWN(["State: UNKNOWN_BARCODE<br/>'no matching student record'"])
    MATCH -->|"Two different payloads<br/>in one frame"| AMBIG(["State: AMBIGUOUS<br/>'present a single card'"])

    MATCH -->|"Yes"| SESSION{"Scan session accepts?<br/>latch released only when the<br/>card leaves the frame"}
    SESSION -->|"Rejected"| DUP(["State: VERIFYING / duplicate suppressed"])
    SESSION -->|"Accepted"| VERIFIED(["State: VERIFIED"])

    VERIFIED --> ROW["Append Scan History row<br/>and persist to barcode_scans"]
    ROW --> BEEP["Play the success cue<br/>(only after decode AND database match)"]
    BEEP --> PANEL["Open the structured Scan Result panel<br/>identity, subjects, instalments"]
    PANEL --> NEXT["Scan Next Student starts a new session"]

    classDef io fill:#EAF3FB,stroke:#3E7CB1,stroke-width:1.5px,color:#1E3A52
    classDef proc fill:#FFE9C7,stroke:#D4761A,stroke-width:1.5px,color:#4A3520
    classDef ok fill:#E9F7EF,stroke:#2E8B57,stroke-width:1.5px,color:#1D4B32
    classDef warn fill:#FFF0E0,stroke:#D4761A,stroke-width:1.5px,color:#7A4A12
    classDef bad fill:#FDEAEA,stroke:#C0392B,stroke-width:1.5px,color:#7B241C
    class START,PRE,CROP,DECODE,REC,FRAME io
    class DET,GATE,LOOKUP,SESSION,ROW,BEEP,PANEL proc
    class VERIFIED ok
    class EDGE,SEARCHING,DUP,DECODED,DECODED2 warn
    class UNKNOWN,AMBIG,UNDECODED bad