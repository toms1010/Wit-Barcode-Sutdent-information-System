erDiagram
    USERS ||--o{ STUDENTS : "creates / updates"
    USERS ||--o{ AUDIT_LOGS : "writes"
    USERS ||--o{ YOLO_MODELS : "trains / activates"

    STUDENTS ||--o{ STUDENT_CONTACTS : "has"
    STUDENTS ||--o{ ENROLLMENTS : "holds"
    STUDENTS ||--o{ BARCODES : "is identified by"
    STUDENTS ||--o{ BARCODE_SCANS : "scanned as"
    STUDENTS ||--o{ ASSESSMENTS : "is assessed in"
    STUDENTS ||--o{ ID_CARDS : "is printed on"

    COURSES ||--o{ SUBJECTS : "offers"
    SUBJECTS ||--o{ ENROLLMENT_SUBJECTS : "appears in"
    ENROLLMENTS ||--o{ ENROLLMENT_SUBJECTS : "contains"

    BARCODES ||--o{ BARCODE_SCANS : "is read in"

    ASSESSMENTS ||--o{ ASSESSMENT_ITEMS : "itemised by"
    ASSESSMENT_CATEGORIES ||--o{ ASSESSMENT_ITEMS : "classifies"
