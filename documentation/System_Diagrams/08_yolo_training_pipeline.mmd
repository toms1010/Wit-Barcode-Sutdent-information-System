    D -->|"Yes"| E["Derive the bounding box<br/>from the real decode<br/>(never hand-drawn)"]
    D -->|"No"| F["Negative panel<br/>(must decode nothing)"]
    E --> G["Assign the split<br/>per physical card"]
    F --> G
    G --> H["datasets/barcode_distance/<br/>images/{train,val,test} + labels/*.txt + data.yaml"]
    H --> I["scripts/train_yolo.py<br/>validate_dataset()"]
    I --> J{"One class 'barcode'?<br/>labels well formed?"}
    J -->|"No"| I2["Stop and report"]
    J -->|"Yes"| K["Ultralytics YOLO('yolov8n.pt').train()<br/>640 px, batch 16, AdamW lr 0.002,<br/>seed 0, tame augmentation,<br/>early stopping patience 30"]
    K --> L["models_yolo/candidates/<run>/<br/>results.csv + weights/best.pt"]
    L --> M["evaluate(): score the candidate and<br/>the active model on the same instrument<br/>(held-out cards, negative panels,<br/>decode rates, mean confidence)"]
    M --> N{"should_promote()"}
    N -->|"Zero false positives on barcode-free<br/>documents AND at least as many held-out<br/>decodes and detections as the active model"| O["Back up models_yolo/active/best.pt<br/>then copy the candidate into place"]
    N -->|"Otherwise"| P["Refuse the swap.<br/>The candidate stays inert."]
    O --> Q["Runtime: only models_yolo/active/best.pt<br/>is loaded by the scanner"]
    P --> Q

