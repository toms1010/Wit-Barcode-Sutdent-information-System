# Database Configuration
# Use the dedicated application account, NOT root.
# The local root account uses auth_socket and only works from a root shell,
# so the application would fail with "1045 Access denied" if DB_USER=root.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=wit_barcode_system
DB_USER=wit_user
DB_PASSWORD=your_password_here

# Application Configuration
APP_NAME=WIT Barcode Student Information System
APP_VERSION=1.0.0
DEBUG=False

# YOLO Model Configuration
YOLO_MODEL_PATH=models_yolo/active/best.pt
YOLO_CONFIDENCE_THRESHOLD=0.35
YOLO_IOU_THRESHOLD=0.45
YOLO_DEVICE=cpu

# Camera Configuration
DEFAULT_CAMERA_INDEX=0
CAMERA_WIDTH=1280
CAMERA_HEIGHT=720
CAMERA_FPS=30

# Barcode Configuration
BARCODE_PREFIX=WIT:STUDENT:
BARCODE_OUTPUT_DIR=generated_barcodes
BARCODE_IMAGE_FORMAT=PNG
BARCODE_MODULE_WIDTH=2
BARCODE_MODULE_HEIGHT=15

# Scan Configuration
SCAN_DUPLICATE_SUPPRESSION_SECONDS=5

# Live Scanner Pipeline
SCAN_REGION_WIDTH_RATIO=0.66
SCAN_REGION_HEIGHT_RATIO=0.42
SCAN_REGION_OVERLAP_THRESHOLD=0.65
SCAN_CROP_MARGIN_RATIO=0.20
SCAN_MIN_CROP_WIDTH=80
SCAN_MIN_CROP_HEIGHT=24
SCAN_COOLDOWN_SECONDS=3.0
SCAN_CONFIRM_FRAMES=1
SCAN_TARGET_FPS=12
SCAN_MIRROR_PREVIEW=True
SCAN_OVERLAY_COLOR=FFD600
SCAN_OVERLAY_HINT=Align barcode inside the yellow frame
SCAN_HISTORY_LIMIT=100

# Report Configuration
REPORTS_OUTPUT_DIR=reports
PDF_PAGE_SIZE=A4

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Admin account provisioning
# The first administrator account is created on database initialization if the
# users table is empty. Provide the password here (or via the environment); if
# omitted, a one-time password is generated and printed to the logs at seed
# time and MUST be changed on first sign-in. Never commit a real password.
WIT_ADMIN_PASSWORD=your_admin_password_here